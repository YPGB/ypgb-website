# Postgres (used by docker compose)
POSTGRES_USER=payload
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ypgb

# Host-side URL (pnpm commands run outside Docker). The app container overrides this to use host "postgres".
DATABASE_URL=postgres://payload:change-me@localhost:5432/ypgb
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare Turnstile (spam protection for forms). Local development uses Cloudflare's test keys when these are empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
